# ==============================================================================
# CrisisGuard Environment Configuration Template
# Copy this file to '.env' and populate with local runtime values.
# DO NOT COMMIT SECRETS OR ACCESS TOKENS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment (development | testing | production)
PROJECT_ENV=development
LOG_LEVEL=INFO

# Kafka Infrastructure Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=crisisguard.stream.raw-events
KAFKA_TOPIC_PROPAGATION=crisisguard.stream.propagation-edges
KAFKA_CONSUMER_GROUP=crisisguard-streaming-group

# Apache Spark Settings
SPARK_MASTER=local[*]
SPARK_APP_NAME=CrisisGuardPipeline
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Storage & Distributed Filesystem (local file:// or hdfs://namenode:8020)
STORAGE_BACKEND=local
HDFS_DEFAULT_FS=hdfs://localhost:9000
HADOOP_HOME=

# Hive Metastore Settings
HIVE_METASTORE_URI=thrift://localhost:9083
HIVE_WAREHOUSE_DIR=./data/processed/hive/warehouse

# Dataset Access Credentials (Required only for authorized raw downloads)
# Leave blank during Phase 0 - Phase 1
KAGGLE_USERNAME=
KAGGLE_KEY=
GEOFABRIK_MIRROR=https://download.geofabrik.de
