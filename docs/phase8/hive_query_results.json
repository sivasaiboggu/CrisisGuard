  "Query 4: Synthetic Media Risk Analysis (Phase 6 Outputs)": {
    "sql": "SELECT media_type, CASE WHEN synthetic_risk >= 0.7 THEN 'HIGH_RISK' WHEN synthetic_risk >= 0.3 THEN 'MEDIUM_RISK' ELSE 'LOW_RISK' END AS risk_tier, COUNT(content_id) AS item_count, ROUND(AVG(model_score), 4) AS avg_model_score, ROUND(AVG(synthetic_probability), 4) AS avg_synthetic_prob FROM crisisguard_phase8.media_risk_features GROUP BY media_type, CASE WHEN synthetic_risk >= 0.7 THEN 'HIGH_RISK' WHEN synthetic_risk >= 0.3 THEN 'MEDIUM_RISK' ELSE 'LOW_RISK' END ORDER BY media_type, item_count DESC",
